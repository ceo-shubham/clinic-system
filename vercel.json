{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "logo.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/logo.png",
      "dest": "/logo.png"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/gate.js",
      "dest": "/gate.js"
    },
    {
      "src": "/doctor.html",
      "dest": "/doctor.html"
    },
    {
      "src": "/manager.html",
      "dest": "/manager.html"
    },
    {
      "src": "/reset.html",
      "dest": "/reset.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
